{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM: os callbacks de page.evaluate rodam no navegador
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    // o Playwright transpila os testes; imports sem extensão, como nos exemplos da spec
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
